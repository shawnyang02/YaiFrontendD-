{
  "name": "yaifrontend",
  "version": "1.0.0",
  "description": "Yai Frontend Project",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "setup:deploy": "node scripts/setup-deploy.js",
    "diagnose:deploy": "node scripts/diagnose-deploy.js",
    "check:github-pages": "node scripts/check-github-pages.js",
    "fix:github-permissions": "node scripts/fix-github-permissions.js",
    "validate:yaml": "node scripts/validate-yaml.js",
    "ts:run": "node --loader ts-node/esm",
    "ts:run-new": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));'",
    "test:debounce": "node --loader ts-node/esm utils/myDebounce.ts",
    "test:debounce-full": "node --loader ts-node/esm utils/test-debounce.ts",
    "lint": "eslint src/**/*.{ts,tsx} utils/**/*.{ts,js} --fix",
    "lint:check": "eslint src/**/*.{ts,tsx} utils/**/*.{ts,js}",
    "lint:fix": "eslint src/**/*.{ts,tsx} utils/**/*.{ts,js} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"utils/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"utils/**/*.{ts,js}\"",
    "format:all": "prettier --write \"**/*.{ts,tsx,js,jsx,css,json,md}\" --ignore-path .prettierignore",
    "code:fix": "npm run lint:fix && npm run format",
    "code:check": "npm run lint:check && npm run format:check",
    "test:format": "node scripts/test-formatting.js",
    "fix:vscode": "node scripts/fix-vscode-formatting.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "typescript",
    "webpack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.5",
    "prettier": "^3.7.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}